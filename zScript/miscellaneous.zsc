// From a co-op game I had.
class CC_InjectableDrywall : UaS_Consumable
{
    mixin CC_EdibleInjectableMixin;

    default
    {
        UaS_Consumable.Calories 9;
        UaS_Consumable.Fluid -1922;
        UaS_Consumable.Bulk 1;

        tag "$CC_IDRYWALL_TAG";
        Uas_Consumable.Description "$CC_IDRYWALL_DESCRIPTION";
    }

    override void Messages()
    {
        AddOpenText(Stringtable.Localize("$CC_IDRYWALL_OPEN1"));
        AddOpenText(Stringtable.Localize("$CC_IDRYWALL_OPEN2"));

        AddConsumeText(Stringtable.Localize("$CC_IDRYWALL_CONSUME1"));
        AddConsumeText(Stringtable.Localize("$CC_IDRYWALL_CONSUME2"));
        AddConsumeText(Stringtable.Localize("$CC_IDRYWALL_CONSUME3"));
        AddConsumeText(Stringtable.Localize("$CC_IDRYWALL_CONSUME4"));
        AddConsumeText(Stringtable.Localize("$CC_IDRYWALL_CONSUME5"));
        AddConsumeText(Stringtable.Localize("$CC_IDRYWALL_CONSUME6"));
    }

	int prevbulk;

	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		prevbulk = weaponbulk();
	}
	override void Tick()
	{
		super.tick();
		weaponstatus[UGCS_SPOILAGE] = 0; // no spoiling. it's fucking drywall. - [Ted]

		if(!tracker || !tracker.owner)
			return;
		HDPlayerPawn hdp = HDPlayerPawn(tracker.owner);
		int bulk = prevbulk - weaponbulk();
		if(bulk > 0){
			hdp.GiveInventory("HDDrugThatKillsYou", 1000);
		}
		prevbulk = weaponbulk();
	}
}

// The drug. That kills you. It kills you. - [Ted]
class HDDrugThatKillsYou : HDDrug
{
    enum KillsYouDrugAmounts
    {
        HDKILLSYOU_DOSE = 1000,
        HDKILLSYOU_MAX = 1,
    }

	override void OnHeartbeat(hdplayerpawn hdp){
		if(amount<1)return;
		int amt=amount;amount--;
		if(amt>1){
			if(hdp.beatcap>max(3,10-(amount>>2)))hdp.beatcap--;
			if(hdp.stunned<5)hdp.stunned+=1;
			if(
				hdp.bloodpressure<25-(hdp.bloodloss>>2)
			)hdp.bloodpressure+=2;
		}
		if(hd_debug>=4)console.printf("Killing you "..amt.."/"..HDKILLSYOU_MAX.."  = "..hdp.strength);
	}
}

class CC_PhysickExplosion : HDActor
{
    Default
    {
		projectile; -nogravity -noteleport +bounceonactors
		-noblockmap -grenadetrail -floorclip +forcexybillboard
		+nodamagethrust +noblood
		bouncetype "doom"; decal "none";
		mass 30; pushfactor 3.4; bouncefactor 0.3; gravity 1;
		deathsound "misc/fragknock";
		bouncesound "misc/fragknock";
		wallbouncesound "misc/fragknock";
		obituary "$OB_WIGEONSKILLISSUE";
		//hdupk.pickupmessage "picked up (and defused) a rocket grenade.";
		damagefactor(0);
		radius 1.5; height 1.5; scale 0.26;
	}
    States{ 
    spawn:
		TNT1 A 1;
		---- A 0{
			A_SprayDecal("BrontoScorch",8);
			A_HDBlast(
				pushradius:256,pushamount:96,fullpushradius:72,
				fragradius:HDCONST_ONEMETRE*10,fragtype:"HDB_fragRL",
				immolateradius:96,immolateamount:random(1,40),
				immolatechance:random(1,stamina)
			);
			self.A_Explode(2000, int(HDCONST_ONEMETRE * 20), XF_HURTSOURCE | XF_NOTMISSILE | XF_EXPLICITDAMAGETYPE, damagetype: 'Holy');
			actor xpl=spawn("Gyrosploder",self.pos-(0,0,1),ALLOW_REPLACE);
			xpl.target=target;xpl.master=master;xpl.stamina=stamina;
			A_SpawnChunksFrags("HDB_fragRL",180);
		}stop;
    }
}

class HDPhysickBLAMBLAM : HDDrug
{
	private PointLight DynLight;
    enum PhysickAmounts
    {
        HDPHYSICK_DOSE = 336,
        HDPHYSICK_MAX = 337,
    }

	override void OnHeartbeat(hdplayerpawn hdp){
		if(amount<1)return;
		int amt=amount;amount--;
		if(amt<=1){
        	hdp.A_SpawnItemEx("CC_PhysickExplosion",0,0,0,0,0,2,0,SXF_NOCHECKPOSITION|SXF_TRANSFERPOINTERS);
		}
		if(hd_debug)console.printf("Killing you "..amt.."/"..HDPHYSICK_MAX.."  = "..hdp.strength);
	}
}

class CC_RCTPhysick : UaS_Consumable 
{
    mixin CC_EdibleInjectableMixin;

    Default 
    {
        tag "$CC_PHYSICK_TAG";
        UaS_Consumable.Description "$CC_PHYSICK_DESCRIPTION";
        UaS_Consumable.Calories 9;
        UaS_Consumable.Fluid -1922;
        UaS_Consumable.Bulk 1;
		UaS_Consumable.OpenSound "mre/sodabottle";
		+UaS_Consumable.DRINKABLE;
		Inventory.PickupMessage "$CC_PHYSICK_PICKUP";
		Inventory.Icon "FLASH0";
		scale 0.45;

		hdweapon.incapweapon "IncapPhysick";
		hdweapon.refid "vtp";
    }

	int prevbulk;

    override void Messages()
    {
       AddOpenText(Stringtable.Localize("$CC_PHYSICK_OPEN1"));
       AddOpenText(Stringtable.Localize("$CC_PHYSICK_OPEN2"));
       
       AddConsumeText(Stringtable.Localize("$CC_PHYSICK_CONSUME1"));
       AddConsumeText(Stringtable.Localize("$CC_PHYSICK_CONSUME2"));
       AddConsumeText(Stringtable.Localize("$CC_PHYSICK_CONSUME3"));
       AddConsumeText(Stringtable.Localize("$CC_PHYSICK_CONSUME4"));
    }

	override void PostBeginPlay()
	{
		super.PostBeginPlay();
		prevbulk = weaponbulk();
	}
	override void Tick()
	{
		super.tick();
		weaponstatus[UGCS_SPOILAGE] = 0; // no spoiling. it's fucking crystal. - [Ted]

		if(!tracker || !tracker.owner)
			return;
		HDPlayerPawn hdp = HDPlayerPawn(tracker.owner);
		int bulk = prevbulk - weaponbulk();
		if(bulk > 0){
			hdp.GiveInventory("HDPhysickBLAMBLAM", 9);
		}
		prevbulk = weaponbulk();
	}

    States
    {
	    spawn:
	    	FLAS H -1;
	    	stop;
    }
}

class IncapPhysick:HDIncapWeapon{
	default{
		hdincapweapon.hudpic "FLASH0";
		hdincapweapon.useitem "CC_RCTPhysick";
		hdincapweapon.spawnthing "InjectPhysickDummy";
		hdincapweapon.debristhing "";
	}

	states{
	useincapthing:
	drinkphysick:
		TNT1 A 1{
			A_SetBlend("FF C0 05",0.1,4);
			A_MuzzleClimb(0,2,wepdot:false);
			A_StartSound("mre/sodabottle",CHAN_WEAPON,CHANF_OVERLAP);

			actor a=spawn(invoker.spawnthing,pos,ALLOW_REPLACE);
			a.accuracy=40;a.target=self;
		}
		TNT1 A 4 A_MuzzleClimb(0,-0.5,0,-0.5,0,-0.5,0,-0.5,wepdot:false);
		TNT1 A 6;
		TNT1 A 0{
			let iii=HDWeapon(findinventory(invoker.useitem));
			if(!!iii){
				iii.weaponstatus[0]|=INJECTF_SPENT;
				DropInventory(iii,1);
			}
			A_SelectWeapon("HDIncapWeapon");
			invoker.goawayanddie();
		}
		goto nope;
	}
}

class InjectPhysickDummy:InjectStimDummy{
	states{
	spawn:
		TNT1 A 60 nodelay{
			tg=HDPlayerPawn(target);
		}
		TNT1 A 1{
			if(!tg||tg.bkilled){destroy();return;}

			let zzz=tg.findinventory("HDPhysickBLAMBLAM");
			if(!zzz||zzz.amount<1){
				tg.A_GiveInventory("HDPhysickBLAMBLAM",9);
			}
		}stop;
	}
}

// For the future. - [Tavi]
class PhysickPointLight:PointLight{
	Color col1;
	Color col2;
	Color col3;
	override void postbeginplay(){
		super.postbeginplay();
		args[0]=0xFF;
		args[1]=0xC0;
		args[2]=0x05;
	}
}