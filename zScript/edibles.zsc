class CC_Ceviche : UaS_Consumable
{
    mixin CC_ComfortMREMixin;

    default
    {
        tag "$CC_CEVICHE_TAG";
        UaS_Consumable.Calories 812;
        UaS_Consumable.Fluid -492;
        Uas_Consumable.Bulk 8;
        UaS_Consumable.Description "$CC_CEVICHE_DESCRIPTION";
