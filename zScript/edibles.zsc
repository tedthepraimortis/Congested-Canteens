    override void Messages() {
        AddOpenText(Stringtable.Localize("$CC_CEVICHE_OPEN1"));
        AddOpenText(Stringtable.Localize("$CC_CEVICHE_OPEN2"));

        AddConsumeText(Stringtable.Localize("$CC_CEVICHE_CONSUME1"));
