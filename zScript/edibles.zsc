class CC_Roundmeal : UaS_Consumable
{
    mixin CC_BaggedMREMixin;

    default
    {
        tag "$CC_ROUNDMEAL_TAG";
        UaS_Consumable.Calories 2691;
        UaS_Consumable.Fluid 492;
        UaS_Consumable.Description "$CC_ROUNDMEAL_DESCRIPTION";
        Scale 1.2;
    }

